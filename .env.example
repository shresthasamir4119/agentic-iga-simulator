# Local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_iga?schema=public

# Docker Compose database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_iga
DATABASE_URL_DOCKER=postgresql://postgres:postgres@agentic-postgres:5432/agentic_iga?schema=public

# Open-weight / OpenAI-compatible model
OPEN_WEIGHT_LLM_URL=http://localhost:11434/v1
OPEN_WEIGHT_LLM_KEY=ollama
OPEN_WEIGHT_MODEL=llama3.1
